# Kopiér til /opt/fangarr/fangarr.env og udfyld. chmod 600 bagefter.
# Skriv aldrig nøglerne i chatten eller i dokumentationen.
TZ=Europe/Copenhagen

# Hvilke Sonarr/Radarr Fangarr må bruge (adskil med komma)
# API-nøgler: Sonarr/Radarr > Settings > General > Security
ARR_INSTANCES=sonarr2,radarr

SONARR_URL=http://sonarr:8989
SONARR_APIKEY=

SONARR2_URL=http://sonarr2:8989
SONARR2_APIKEY=

RADARR_URL=http://radarr:7878
RADARR_APIKEY=

# autobrr (valgfrit – så kan Fangarr oprette filtrene selv)
# API-nøgle: autobrr > Settings > API keys > Add new
AUTOBRR_URL=http://autobrr:7474
AUTOBRR_APIKEY=

# Adressen autobrr bruger til at kalde Fangarr (Docker-netværket)
FANGARR_URL=http://fangarr:8080

# Telegram-botten Stream365 Drift (token ligger i password manageren)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=731397952

# Tracearr (valgfrit – statistik). Tracearr kører på Mediabox, så brug den offentlige adresse
# API-nøgle: Tracearr > Settings (Public API / API key)
TRACEARR_URL=https://tracearr.stream365.vip
TRACEARR_APIKEY=

# Seerr (valgfrit – spring titler over, der er afvist/anmodet i Seerr)
# API-nøgle: Seerr > Settings > General > API Key
SEERR_URL=http://seerr:5055
SEERR_APIKEY=
